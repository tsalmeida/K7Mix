<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:K7Mix.Views"
        x:Class="K7Mix.Views.MainWindow"
        Icon="/Assets/app.ico"
        Title="K7 Mix"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="560"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource TkxPage}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Design.axaml is the shared standard and is copied whole, so the icon face
         is set up here instead of being added to it. -->
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource K7Icons}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border Classes="page">
    <DockPanel Margin="12">
      <Border DockPanel.Dock="Top" Classes="section bar" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="K7 Mix" VerticalAlignment="Center" />
            <TextBlock Classes="caption" Text="Cassette mixes" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="pill lime" Click="OnNewClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xf15b;" />
                <TextBlock Text="New" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill amber" Click="OnImportClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xf56f;" />
                <TextBlock Text="Import Markdown" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill amber" Click="OnOpenClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xf07c;" />
                <TextBlock Text="Open" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill lime" Click="OnSaveClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xf0c7;" />
                <TextBlock Text="Save" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill green" Click="OnSaveLockedClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xf023;" />
                <TextBlock Text="Save locked copy" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="pill pink" Click="OnPrintClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xf02f;" />
                <TextBlock Text="Print insert" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Classes="section bar" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" Classes="caption"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Grid.Column="1" Classes="caption"
                     Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="340,*,300" ColumnSpacing="12">
        <ScrollViewer Grid.Column="0">
          <StackPanel Spacing="12">
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Cassette" />
                <views:CassetteView x:Name="TapeView" Height="200" />
                <TextBlock Classes="caption" Text="The same plate Running Wild draws on the Settings table." />
              </StackPanel>
            </Border>
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Jewel case" />
                <views:JewelCaseView x:Name="CaseView" Height="170" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="The J-card as it prints: front, spine and back, with the fold lines. Artwork is cropped from the middle to fit each panel. Print insert writes the PDF at actual size." />
              </StackPanel>
            </Border>
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Transport" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Skip honours the transition. That cannot be turned off. At the end, the tape loops back to track 1." />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <!-- The glyph on this one follows the transport: play when it is
                       not playing, pause when it is. See UpdateNowPlaying. -->
                  <Button Classes="pill lime" Click="OnPlayPauseClick"
                          ToolTip.Tip="Play / Pause"
                          AutomationProperties.Name="Play / Pause">
                    <TextBlock x:Name="PlayPauseIcon" Classes="icon" Text="&#xf04b;" />
                  </Button>
                  <Button Classes="pill orange" Click="OnStopClick"
                          ToolTip.Tip="Stop" AutomationProperties.Name="Stop">
                    <TextBlock Classes="icon" Text="&#xf04d;" />
                  </Button>
                  <Button Classes="pill amber" Click="OnNextClick"
                          ToolTip.Tip="Next track" AutomationProperties.Name="Next track">
                    <TextBlock Classes="icon" Text="&#xf051;" />
                  </Button>
                </StackPanel>
                <TextBlock x:Name="NowPlayingTitle" Classes="subheading"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <Border Height="14" CornerRadius="7" ClipToBounds="True"
                        Background="{DynamicResource TkxPage}"
                        BorderBrush="{DynamicResource TkxBorder}"
                        BorderThickness="2">
                  <Panel x:Name="ProgressArea" SizeChanged="OnProgressSizeChanged">
                    <Rectangle x:Name="ProgressFill" Width="0"
                               HorizontalAlignment="Left"
                               Fill="{DynamicResource TkxAccent}" />
                    <Rectangle x:Name="LoopMark" Width="2" IsVisible="False"
                               HorizontalAlignment="Left"
                               Fill="{DynamicResource TkxText}" />
                  </Panel>
                </Border>
                <TextBlock x:Name="NowPlayingText" Classes="caption" TextWrapping="Wrap" />
                <TextBlock x:Name="DurationText" Classes="caption" TextWrapping="Wrap" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Packaging music does not make distributing it permissible." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Classes="section">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="heading" Text="Tracks" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Classes="pill lime" Click="OnAddTracksClick"
                          ToolTip.Tip="Add tracks" AutomationProperties.Name="Add tracks">
                    <TextBlock Classes="icon" Text="&#x2b;" />
                  </Button>
                  <Button Classes="pill amber" Click="OnMoveUpClick"
                          ToolTip.Tip="Move up" AutomationProperties.Name="Move up">
                    <TextBlock Classes="icon" Text="&#xf062;" />
                  </Button>
                  <Button Classes="pill amber" Click="OnMoveDownClick"
                          ToolTip.Tip="Move down" AutomationProperties.Name="Move down">
                    <TextBlock Classes="icon" Text="&#xf063;" />
                  </Button>
                  <Button Classes="pill orange" Click="OnRemoveTrackClick"
                          ToolTip.Tip="Remove track" AutomationProperties.Name="Remove track">
                    <TextBlock Classes="icon" Text="&#xf1f8;" />
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="A transition belongs to the track it leads into, so it stays with that track through a reorder. Track 1's is the loop back to the start, played when the tape reaches the end." />
            </StackPanel>
            <ListBox x:Name="TrackList" SelectionChanged="OnTrackSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="2">
          <StackPanel Spacing="12">
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Mix" />
                <TextBlock Classes="caption" Text="Title" />
                <TextBox x:Name="TitleBox" TextChanged="OnMetadataChanged" />
                <TextBlock Classes="caption" Text="Description" />
                <TextBox x:Name="DescriptionBox" Classes="prose" AcceptsReturn="True" Height="88" TextChanged="OnMetadataChanged" />
                <TextBlock Classes="caption" Text="Source URL (Link)" />
                <TextBox x:Name="SourceBox" TextChanged="OnMetadataChanged" />
                <TextBlock Classes="caption" Text="License" />
                <TextBox x:Name="LicenseBox" TextChanged="OnMetadataChanged" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Classes="caption" Text="Text for side A" />
                    <TextBox x:Name="SideABox" TextChanged="OnMetadataChanged" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="caption" Text="Text for side B" />
                    <TextBox x:Name="SideBBox" TextChanged="OnMetadataChanged" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="caption" Text="Side B starting track (blank = all on A)" />
                <TextBox x:Name="SideBStartBox" TextChanged="OnMetadataChanged" />
              </StackPanel>
            </Border>
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Appearance" />
                <TextBlock Classes="caption" Text="Font" />
                <ComboBox x:Name="FontBox" SelectionChanged="OnFontChanged" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Classes="caption" Text="Tape color" />
                    <TextBox x:Name="TapeColorBox" TextChanged="OnMetadataChanged" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Classes="caption" Text="Sticker color" />
                    <TextBox x:Name="StickerColorBox" TextChanged="OnMetadataChanged" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="caption" Text="Text color" />
                    <TextBox x:Name="TextColorBox" TextChanged="OnMetadataChanged" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <Button Classes="pill amber" Click="OnFrontArtClick"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Choose the picture for the front of the jewel case">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="icon" Text="&#xf03e;" />
                      <TextBlock Text="Front" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="pill amber" Click="OnBackArtClick"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Choose the picture for the back of the jewel case">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="icon" Text="&#xf03e;" />
                      <TextBlock Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Selected track" />
                <TextBlock Classes="caption" Text="Title" />
                <TextBox x:Name="TrackTitleBox" TextChanged="OnTrackFieldsChanged" />
                <TextBlock Classes="caption" Text="Codename" />
                <TextBox x:Name="TrackCodenameBox" TextChanged="OnTrackFieldsChanged" />
                <TextBlock Classes="caption" Text="License" />
                <TextBox x:Name="TrackLicenseBox" TextChanged="OnTrackFieldsChanged" />
                <TextBlock Classes="caption" Text="Source" />
                <TextBox x:Name="TrackSourceBox" TextChanged="OnTrackFieldsChanged" />
                <TextBlock Classes="caption" Text="Audio file" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                  <TextBlock x:Name="TrackAudioPathText"
                             Classes="caption mono"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="pill amber" Click="OnSetAudioFileClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="icon" Text="&#xf001;" />
                      <TextBlock Text="Set audio file…" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="AudioOpenButton" Grid.Column="2" Classes="pill amber"
                          Click="OnOpenTrackAudioClick"
                          ToolTip.Tip="Open the audio file with its default application"
                          AutomationProperties.Name="Open audio file"
                          IsEnabled="False">
                    <TextBlock Classes="icon" Text="&#xf144;" />
                  </Button>
                  <Button x:Name="AudioFolderButton" Grid.Column="3" Classes="pill amber"
                          Click="OnOpenTrackAudioFolderClick"
                          ToolTip.Tip="Open the audio file's folder in the default file manager"
                          AutomationProperties.Name="Open audio file folder"
                          IsEnabled="False">
                    <TextBlock Classes="icon" Text="&#xf07c;" />
                  </Button>
                </Grid>
                <CheckBox x:Name="TrackLoopBox"
                          Content="Play this track twice before moving on"
                          IsCheckedChanged="OnTrackLoopChanged" />
                <TextBlock Classes="caption" Text="Transition into this track" />
                <TextBlock x:Name="TransitionHintText" Classes="caption" TextWrapping="Wrap" />
                <ComboBox x:Name="TransitionKindBox" SelectionChanged="OnTransitionChanged" />
                <TextBlock Classes="caption" Text="Duration in seconds" />
                <TextBox x:Name="TransitionDurationBox" TextChanged="OnTransitionDurationChanged" />
                <Button Classes="pill lime" Click="OnSideBHereClick"
                        ToolTip.Tip="Make this track the first track on side B"
                        AutomationProperties.Name="This track starts side B">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xf024;" />
                    <TextBlock Text="This track starts side B" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
