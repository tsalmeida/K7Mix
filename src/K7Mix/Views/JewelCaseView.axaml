<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="K7Mix.Views.JewelCaseView">
  <!--
    The flat J-card as it prints, at two pixels per millimetre, so the preview and
    the PDF are the same shape: flaps 10 mm, face 64 mm, front 100 mm, spine
    12.5 mm, back 70 mm. Every panel clips, so artwork set to UniformToFill is
    centre-cropped on screen exactly as it is centre-cropped in the package.
  -->
  <Viewbox Stretch="Uniform">
    <Grid Width="365" Height="168"
          RowDefinitions="20,128,20"
          ColumnDefinitions="200,25,140">

      <Border x:Name="TopFlap" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />
      <Border x:Name="BottomFlap" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" />

      <Border x:Name="FrontPanel" Grid.Row="1" Grid.Column="0" ClipToBounds="True">
        <Panel>
          <Image x:Name="FrontArt" Stretch="UniformToFill" />
          <TextBlock x:Name="FrontTitle"
                     Classes="heading"
                     Margin="10"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </Panel>
      </Border>

      <Border x:Name="Spine" Grid.Row="1" Grid.Column="1" ClipToBounds="True">
        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
          <LayoutTransformControl.LayoutTransform>
            <RotateTransform Angle="-90" />
          </LayoutTransformControl.LayoutTransform>
          <TextBlock x:Name="SpineText"
                     FontSize="10"
                     MaxWidth="120"
                     TextAlignment="Center"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
        </LayoutTransformControl>
      </Border>

      <Border x:Name="BackPanel" Grid.Row="1" Grid.Column="2" ClipToBounds="True">
        <Panel>
          <Image x:Name="BackArt" Stretch="UniformToFill" />
          <TextBlock x:Name="BackText"
                     Classes="caption"
                     Margin="8"
                     TextWrapping="Wrap"
                     VerticalAlignment="Top" />
        </Panel>
      </Border>

      <!-- Fold lines, drawn over the panels they separate. -->
      <Rectangle Grid.Row="1" Grid.Column="0" Width="1"
                 HorizontalAlignment="Right" Fill="#55000000" />
      <Rectangle Grid.Row="1" Grid.Column="1" Width="1"
                 HorizontalAlignment="Right" Fill="#55000000" />
      <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="1"
                 VerticalAlignment="Bottom" Fill="#55000000" />
      <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="1"
                 VerticalAlignment="Top" Fill="#55000000" />
    </Grid>
  </Viewbox>
</UserControl>
