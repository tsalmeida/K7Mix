<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="K7Mix.Views.JewelCaseView">
  <Viewbox Stretch="Uniform">
    <Canvas Width="360" Height="200">
      <!-- Back of the case, offset -->
      <Border x:Name="BackPanel"
              Canvas.Left="48" Canvas.Top="18"
              Width="250" Height="150"
              CornerRadius="3"
              BorderThickness="2"
              BorderBrush="#88c8d8e8">
        <Panel>
          <Image x:Name="BackArt" Stretch="UniformToFill" />
          <TextBlock x:Name="BackText"
                     Margin="10"
                     Classes="caption"
                     TextWrapping="Wrap" />
        </Panel>
      </Border>
      <!-- Spine -->
      <Border x:Name="Spine"
              Canvas.Left="28" Canvas.Top="18"
              Width="22" Height="150"
              BorderThickness="2,2,0,2"
              BorderBrush="#88c8d8e8">
        <TextBlock x:Name="SpineText"
                   FontSize="11"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="2" />
      </Border>
      <!-- Front, sitting on the spine like a Norelco box -->
      <Border x:Name="FrontPanel"
              Canvas.Left="48" Canvas.Top="10"
              Width="250" Height="150"
              CornerRadius="3"
              BorderThickness="2"
              BorderBrush="#b8dce8f0">
        <Panel>
          <Image x:Name="FrontArt" Stretch="UniformToFill" />
          <StackPanel VerticalAlignment="Center" Margin="12">
            <TextBlock x:Name="FrontTitle"
                       Classes="heading"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FrontHint"
                       Classes="caption"
                       TextAlignment="Center"
                       Margin="0,6,0,0"
                       Text="Jewel case (crude)" />
          </StackPanel>
        </Panel>
      </Border>
    </Canvas>
  </Viewbox>
</UserControl>
